.PROGRAM safe.home()@26/10/16 00:16 #0;
;
; Check if robot already in home
  IF SIG(do.home) THEN
    CALL log("Robot is already in home position")
    CALL grip.release
    RETURN
  END
;
; Set small speed
  SPEED 10 ALWAYS
  ACCURACY 50 ALWAYS
;
; Motion
  HERE .pose
  POINT/Z .pose = #HOME(1)
  LMOVE .pose
  CALL log("Perform safe motion to home position: going up")
  HOME
  CALL log("Perform safe motion to home position: move to home")
  CALL grip.release
  TWAIT 2
  RETURN
;
.END
